import stainless.lang._

object barthe {
  // MODEL
  
  def fM(n: BigInt, c: BigInt): BigInt = {
    f_loopM(n, c, 0, 0, 0)
  }
  
  def f_loopM(n: BigInt, c: BigInt, i: BigInt, j: BigInt, x: BigInt): BigInt = {
    decreases(if (n - i < 0) BigInt(0) else n - i)
    if i < n then
      val j = 5 * i + c
      f_loopM(n, c, i + 1, j, x + j)
    else
      x
  }
  
  // CANDIDATE
  
  def f1(n: BigInt, c: BigInt): BigInt = {
    f_loop1(n, c, 0, c, 0)
  }
  
  def f_loop1(n: BigInt, c: BigInt, i: BigInt, j: BigInt, x: BigInt): BigInt = {
    decreases(if (n - i < 0) BigInt(0) else n - i)
    if i < n then
      f_loop1(n, c, i + 1, j + 5, x + j)
    else
      x
  }
}
