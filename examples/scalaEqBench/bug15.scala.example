import stainless.lang._

object bug15 {
  // MODEL
  
  def fM(z: BigInt): BigInt = {
    f_loopM(1) * 2
  }
  
  def f_loopM(x: BigInt): BigInt = {
    require(x > 0)
    decreases(if (10 - x < 0) BigInt(0) else 10 - x)
    if x < 10 then
      val y = 2 + x
      f_loopM(y + y)
    else
      x
  }
  
  // CANDIDATE
  
  def f1(z: BigInt): BigInt = {
    2 * f_loop1(1)
  }
  
  def f_loop1(x: BigInt): BigInt = {
    require(x > 0)
    decreases(if (9 - x < 0) BigInt(0) else 9 - x)
    if x <= 9 then
      val y = x + 2
      f_loop1(2 * y)
    else
      x
  }
}
