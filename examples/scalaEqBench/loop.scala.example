import stainless.lang._

object loop {
  // MODEL
  
  def fM(n: Double): Double = {
    f_loopM(n, 0.0, 0.0)
  }
  
  def f_loopM(n: Double, i: Double, j: Double): Double = {
    decreases(if (n - i < 0) BigInt(0) else n - i)
    if i <= n then
      f_loopM(n, i + 1.0, j + 1.0)
    else
      j
  }
  
  // CANDIDATE
  
  def f1(n: Double): Double = {
    f_loop1(n, n, 0.0)
  }
  
  def f_loop1(n: Double, i: Double, j: Double): Double = {
    if i >= 0.0 then
      f_loop1(n, i - 1.0, j + 1.0)
    else
      j
  }
}
